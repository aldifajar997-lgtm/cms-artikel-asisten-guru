{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cms3",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-03",
  // PENTING: Secret TIDAK boleh disimpan di file ini (bisa ke-commit ke git).
  // Untuk production: gunakan `wrangler secret put <NAMA_SECRET>`
  //   wrangler secret put JWT_SECRET
  //   wrangler secret put SUPER_ADMIN_EMAIL
  //   wrangler secret put SUPER_ADMIN_PASSWORD_HASH
  //
  // Untuk local dev: buat file .dev.vars (sudah di-.gitignore)
  //   Lihat .dev.vars.example untuk format
  "routes": [
    {
      "pattern": "cms.your-domain.com",
      "zone_name": "your-domain.com",
      "custom_domain": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "your-kv-namespace-id-here",
      "preview_id": "your-kv-preview-id-here"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "cms-media-bucket"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cms-db",
      "database_id": "your-d1-database-id-here"
    }
  ],
  "vars": {
    "FRONTEND_URL": "https://your-frontend-domain.com",
    "HUB_URL": "https://your-hub-domain.com",
    "ALLOWED_ORIGINS": "https://your-frontend-domain.com,https://your-hub-domain.com",
    "TURNSTILE_HOSTNAMES": "cms.your-domain.com,your-frontend-domain.com"
  }
}